{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shotate",
  "mainBinaryName": "shotate",
  "version": "../package.json",
  "identifier": "com.baney.snapmark",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "publisher": "Donovan Baney",
    "copyright": "\u00a9 2026 Donovan Baney (@baney75). MIT License.",
    "category": "Utility",
    "shortDescription": "Fast, free screenshot and annotation tool",
    "longDescription": "Shotate captures an area, a window or the whole screen, lets you mark it up with arrows, boxes, highlights, text, numbered steps and real redaction, and copies the result. No account, no network code.",
    "homepage": "https://github.com/baney75/shotate",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg"
        ],
        "name": "Image",
        "role": "Editor",
        "mimeType": "image/png"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
